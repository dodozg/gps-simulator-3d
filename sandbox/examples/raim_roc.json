{
  "name": "raim_roc",
  "description": "RAIM: vjerojatnost detekcije (po epohi) vs veličina kvara sata jednog satelita, za više P_FA — ROC-olika studija. Kvar je korak na nasumično odabranom praćenom satelitu od t=30 s.",
  "world": {"lat": 45.815, "lon": 15.982, "alt": 120, "duration_s": 120, "systems": ["GPS"], "terrain": false},
  "seeds": 5,
  "attack": {"type": "sat_fault", "bias_m": 0, "start": 30},
  "sweep": {"attack.bias_m": [0, 5, 10, 15, 20, 30, 45, 60], "raim.pfa": [1e-2, 1e-3, 1e-5, 1e-7]},
  "estimators": ["ekf"],
  "metrics": ["raim_pd", "false_alarm_rate", "correct_exclusion_rate", "time_to_detect", "mi_events", "h_err_p95", "hpl_median"],
  "warmup_s": 20,
  "plot": [{"metric": "raim_pd", "x": "attack.bias_m"}, {"metric": "h_err_p95", "x": "attack.bias_m"}]
}
